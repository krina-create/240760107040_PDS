
print("1. if Statement")
num = 10
if num > 0:
    print(num, "is Positive")

print("\n2. if-else Statement")
num = -5
if num >= 0:
    print(num, "is Positive")
else:
    print(num, "is Negative")

print("\n3. if-elif-else Statement")
marks = 75
if marks >= 90:
    print("Grade: A")
elif marks >= 75:
    print("Grade: B")
elif marks >= 50:
    print("Grade: C")
else:
    print("Grade: Fail")

print("\n4. while Loop")
i = 1
while i <= 5:
    print(i, end=" ")
    i += 1
print()

print("\n5. for Loop")
for i in range(1, 6):
    print(i, end=" ")
print()

print("\n6. Nested Loop")
for i in range(1, 4):
    for j in range(1, 4):
        print(f"({i},{j})", end=" ")
    print()

print("\n7. break Statement")
for i in range(1, 11):
    if i == 6:
        break
    print(i, end=" ")
print()

print("\n8. continue Statement")
for i in range(1, 11):
    if i % 2 == 0:
        continue
    print(i, end=" ")
print()

print("\n9. pass Statement")
for i in range(1, 6):
    if i == 3:
        pass   
    print(i)

print("\nProgram Executed Successfully!")
